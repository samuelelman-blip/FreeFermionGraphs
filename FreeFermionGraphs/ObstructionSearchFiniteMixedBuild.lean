import FreeFermionGraphs.ObstructionSearchFiniteMixedLemma11ATrace

/-!
# Constructing finite traces from literal Definition 19 blocks

The obstruction search is naturally an inductively generated finite block
execution.  This file supplies its base constructor.  A single concrete path
block, together with its selected side and local Definition 19 data, is
flattened into a complete deformation and packaged as a one-block
`FiniteMixedSideSearchTrace`.

The flattened-step correspondence is constructed definitionally.  No search
history, Lemma 11 conclusion, or Lemma 14 conclusion is assumed.
-/

universe u

variable {V : Type u}

namespace SimpleGraph

namespace FixedPairingPathFamily

variable {G : SimpleGraph V}
  {O : FixedPairingPathFamily G}
  {Cprime : Set V}

namespace ConcretePathDeformation

private theorem reorient_lastIndex_eq
    (D : ConcretePathDeformation O Cprime)
    (side : DeformationSide) :
    (D.reorient side).lastIndex = D.lastIndex := by
  apply Fin.ext
  rfl

private theorem reorient_step_removedVertex_eq
    (D : ConcretePathDeformation O Cprime)
    (side : DeformationSide)
    (i : Fin D.deformation.stepCount) :
    ((D.reorient side).deformation.step i).before.vertex
        ((D.reorient side).deformation.step i).removedIndex =
      (D.deformation.step i).before.vertex
        (D.deformation.step i).removedIndex := by
  cases side <;> rfl

/-- Flatten a single oriented Definition 19 path block without forgetting any
of its steps. -/
def toFullDefinition19Deformation
    (D : ConcretePathDeformation O Cprime)
    (side : DeformationSide)
    (F : (D.reorient side).FullDefinition19Lemma11AData) :
    FullDefinition19Deformation O Cprime where
  deformation := D.deformation
  nonempty := D.nonempty
  introduced_mem_prime := by
    intro i
    simpa using F.neighborhood.primeHole.introduced_mem i
  removedPrime_hasSuccessor := by
    intro i hiPrime
    by_cases hiLast : i.val + 1 = D.deformation.stepCount
    · have hiEq : i = D.lastIndex := by
        apply Fin.ext
        change i.val = D.deformation.stepCount - 1
        omega
      subst i
      exact (F.terminalRemoved_not_mem_prime (by
        rw [reorient_lastIndex_eq,
          reorient_step_removedVertex_eq]
        exact hiPrime)).elim
    · have hjLt : i.val + 1 < D.deformation.stepCount := by
        have hiLt := i.isLt
        omega
      let j : Fin D.deformation.stepCount := ⟨i.val + 1, hjLt⟩
      let A := D.reorient side
      let L := F.neighborhood.pathOrder
      refine ⟨j, rfl, ?_, ?_, ?_⟩
      · have hpath :
            G.Adj
              (A.path.vertex (L.removedPathIndex i))
              (A.path.vertex (L.introducedPathIndex j)) := by
          apply (A.path.adj_iff _ _).2
          left
          rw [L.removed_index_val, L.introduced_index_val]
          dsimp [j]
          omega
        rw [L.removed_eq i, L.introduced_eq j] at hpath
        rw [reorient_step_removedVertex_eq,
          D.reorient_step_introduced] at hpath
        exact hpath
      · intro hremoved
        have hremovedA :
            ((A.deformation.step i).before.vertex
                (A.deformation.step i).removedIndex) =
              ((A.deformation.step j).before.vertex
                (A.deformation.step j).removedIndex) := by
          rw [reorient_step_removedVertex_eq,
            reorient_step_removedVertex_eq]
          exact hremoved
        have hpathEq :
            A.path.vertex (L.removedPathIndex i) =
              A.path.vertex (L.removedPathIndex j) := by
          rw [L.removed_eq i, L.removed_eq j]
          exact hremovedA
        have hindex := A.path.injective hpathEq
        have hval := congrArg Fin.val hindex
        rw [L.removed_index_val, L.removed_index_val] at hval
        dsimp [j] at hval
        omega
      · intro hadj
        have hadjA :
            G.Adj
              ((A.deformation.step i).before.vertex
                (A.deformation.step i).removedIndex)
              ((A.deformation.step j).before.vertex
                (A.deformation.step j).removedIndex) := by
          rw [reorient_step_removedVertex_eq,
            reorient_step_removedVertex_eq]
          exact hadj
        have hpathAdj :
            G.Adj
              (A.path.vertex (L.removedPathIndex i))
              (A.path.vertex (L.removedPathIndex j)) := by
          rw [L.removed_eq i, L.removed_eq j]
          exact hadjA
        have hindices := (A.path.adj_iff _ _).1 hpathAdj
        rw [L.removed_index_val, L.removed_index_val] at hindices
        dsimp [j] at hindices
        omega

/-- Search output generated by one literal path block. -/
def singleBlockSearch
    (D : ConcretePathDeformation O Cprime)
    (side : DeformationSide)
    (F : (D.reorient side).FullDefinition19Lemma11AData) :
    SearchDeformation O Cprime where
  run := some (D.toFullDefinition19Deformation side F)

namespace FiniteMixedSideSearchTrace

variable {originalHole : IndexedInducedHole G}

/-- Base constructor for an inductively generated finite obstruction-search
trace. -/
def single
    (D : ConcretePathDeformation O Cprime)
    (side : DeformationSide)
    (F : (D.reorient side).FullDefinition19Lemma11AData)
    (hOriginal : Set.range D.initialHole.vertex =
      Set.range originalHole.vertex)
    (hRemoved : ∀ s : Fin D.deformation.stepCount,
      (D.deformation.step s).before.vertex
          (D.deformation.step s).removedIndex ∈
        Set.range originalHole.vertex)
    (hUnique : O.IsUniqueContainingPath
      (D.deformation.step D.firstIndex).introduced
      (Set.range D.path.vertex)) :
    FiniteMixedSideSearchTrace
      (D.singleBlockSearch side F) originalHole where
  flattened := D.toFullDefinition19Deformation side F
  run_eq := rfl
  blockCount := 1
  blockCount_pos := by omega
  block := fun _ => D
  side := fun _ => side
  localData := fun _ => F
  chain := by
    intro i j hij
    have hi : i.val = 0 := by omega
    have hj : j.val = 0 := by omega
    omega
  originalHole_eq := hOriginal
  removed_mem_original := by
    intro _ s
    exact hRemoved s
  path_pairwise := by
    intro i j hij
    exfalso
    apply hij
    apply Fin.ext
    omega
  firstIntroduced_uniquePath := by
    intro _
    exact hUnique
  stepIndex := fun _ s => s
  step_eq := by
    intro _ _
    rfl
  stepIndex_surjective := by
    intro k
    exact ⟨⟨0, by omega⟩, k, rfl⟩
  stepIndex_order := by
    intro i j s t h
    rcases h with hij | ⟨_hij, hst⟩
    · have hi : i.val = 0 := by omega
      have hj : j.val = 0 := by omega
      omega
    · exact hst

end FiniteMixedSideSearchTrace

end ConcretePathDeformation

end FixedPairingPathFamily

end SimpleGraph

import FreeFermionGraphs.ObstructionSearchFiniteMixedExecutableTerminalBalance
import FreeFermionGraphs.ObstructionSearchFiniteMixedDistinctPropagationTrace

/-!
# Inductively generated unequal-centre propagation

The unequal-centre branch of Lemma 14(iv) carries an original-hole vertex
through a finite sequence of actual execution paths.  This file makes that
finite construction explicit.  A zero-hop start records the first carried
vertex.  Each `snoc` hop records one actual ordered path containing the current
and next carried vertices and proves that the avoidance invariant is preserved.

The resulting bounded trace is therefore generated by finite constructors.  It
is not accepted as an unrelated terminal certificate.
-/

universe u

variable {V : Type u}

namespace SimpleGraph
namespace FixedPairingPathFamily

variable {G : SimpleGraph V}
  {families : PairingType → FixedPairingPathFamily G}
  {Cprime : Set V}

namespace ObstructionSearchInitialization

variable {I : ObstructionSearchInitialization families Cprime}

namespace FiniteMixedSideDistinctPropagationTrace

variable {T : I.InitializationFiniteMixedSideTerminalCoreData}
  {hclaw : G.IsClawFree}
  {target source : I.Node}
  {incoming : I.graph.Arc source target}
  {F : FiniteMixedSideTerminalTwoStepFlanks T target}

/-- Zero-hop propagation.  The initial carried vertex already supplies the
third neighbour needed at the end of the propagation. -/
def start
    (predecessorOccurrence :
      Nonempty (FiniteMixedSideFirstBlockFlankOccurrence T F source incoming))
    (previous_outside_originalHole :
      F.towardEndpointVertex (T.currentSlot source target) ∉
        Set.range
          T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex)
    (center : V)
    (initialIndex : Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card)
    (initial_avoidance :
      initialIndex ∉
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
            (F.towardEndpointVertex (T.currentSlot source target)) ∧
        initialIndex ≠ T.targetCloneIndexOfIncoming hclaw incoming ∧
        ¬CyclicAdjacent
          (T.targetCloneIndexOfIncoming hclaw incoming) initialIndex)
    (clone_avoids_previousNeighbors :
      T.targetCloneIndexOfIncoming hclaw incoming ∉
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
          (F.towardEndpointVertex (T.currentSlot source target)))
    (adj_previous :
      G.Adj center
        (F.towardEndpointVertex (T.currentSlot source target)))
    (adj_initial :
      G.Adj center
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
          initialIndex))
    (adj_stoppingCloneCenter :
      G.Adj center
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
          (T.targetCloneIndexOfIncoming hclaw incoming))) :
    FiniteMixedSideDistinctPropagationTrace T hclaw F source incoming where
  predecessorOccurrence := predecessorOccurrence
  previous_outside_originalHole := previous_outside_originalHole
  center := center
  hopCount := 0
  carriedIndex := fun _ => initialIndex
  hopBlock := fun k => Fin.elim0 k
  carried_mem_hopPath := fun k => Fin.elim0 k
  next_mem_hopPath := fun k => Fin.elim0 k
  carried_avoidance := fun _ => initial_avoidance
  clone_avoids_previousNeighbors := clone_avoids_previousNeighbors
  adj_previous := adj_previous
  adj_finalCarried := adj_initial
  adj_stoppingCloneCenter := adj_stoppingCloneCenter

/-- Append one carried original-hole index. -/
def snocCarriedIndex
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (nextIndex : Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card) :
    Fin (X.hopCount + 2) → Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card :=
  Fin.lastCases nextIndex X.carriedIndex

/-- Append one actual execution path to the hop sequence. -/
def snocHopBlock
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (block : Fin
      (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
        source).blockCount) :
    Fin (X.hopCount + 1) → Fin
      (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
        source).blockCount :=
  Fin.lastCases block X.hopBlock

@[simp] theorem snocCarriedIndex_castSucc
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (nextIndex : Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card)
    (k : Fin (X.hopCount + 1)) :
    X.snocCarriedIndex nextIndex (Fin.castSucc k) = X.carriedIndex k := by
  simp [snocCarriedIndex]

@[simp] theorem snocCarriedIndex_last
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (nextIndex : Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card) :
    X.snocCarriedIndex nextIndex (Fin.last (X.hopCount + 1)) = nextIndex := by
  simp [snocCarriedIndex]

@[simp] theorem snocHopBlock_castSucc
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (block : Fin
      (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
        source).blockCount)
    (k : Fin X.hopCount) :
    X.snocHopBlock block (Fin.castSucc k) = X.hopBlock k := by
  simp [snocHopBlock]

@[simp] theorem snocHopBlock_last
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (block : Fin
      (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
        source).blockCount) :
    X.snocHopBlock block (Fin.last X.hopCount) = block := by
  simp [snocHopBlock]

/-- One inductive hop through an actual ordered execution path. -/
def snoc
    (X : FiniteMixedSideDistinctPropagationTrace
      T hclaw F source incoming)
    (block : Fin
      (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
        source).blockCount)
    (nextIndex : Fin
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card)
    (current_mem_path :
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
          (X.carriedIndex X.finalIndex) ∈
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
          source).path block)
    (next_mem_path :
      T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
          nextIndex ∈
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
          source).path block)
    (next_avoidance :
      nextIndex ∉
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
            (F.towardEndpointVertex (T.currentSlot source target)) ∧
        nextIndex ≠ T.targetCloneIndexOfIncoming hclaw incoming ∧
        ¬CyclicAdjacent
          (T.targetCloneIndexOfIncoming hclaw incoming) nextIndex)
    (adj_next :
      G.Adj X.center
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
          nextIndex)) :
    FiniteMixedSideDistinctPropagationTrace T hclaw F source incoming where
  predecessorOccurrence := X.predecessorOccurrence
  previous_outside_originalHole := X.previous_outside_originalHole
  center := X.center
  hopCount := X.hopCount + 1
  carriedIndex := X.snocCarriedIndex nextIndex
  hopBlock := X.snocHopBlock block
  carried_mem_hopPath := by
    intro k
    refine Fin.lastCases ?_ (fun old => ?_) k
    · simpa [FiniteMixedSideDistinctPropagationTrace.finalIndex] using
        current_mem_path
    · simpa using X.carried_mem_hopPath old
  next_mem_hopPath := by
    intro k
    refine Fin.lastCases ?_ (fun old => ?_) k
    · simpa using next_mem_path
    · simpa using X.next_mem_hopPath old
  carried_avoidance := by
    intro k
    refine Fin.lastCases next_avoidance (fun old => X.carried_avoidance old) k
  clone_avoids_previousNeighbors := X.clone_avoids_previousNeighbors
  adj_previous := X.adj_previous
  adj_finalCarried := by
    simpa [FiniteMixedSideDistinctPropagationTrace.finalIndex] using adj_next
  adj_stoppingCloneCenter := X.adj_stoppingCloneCenter

/-- Proof that a bounded propagation trace was produced only by the literal
zero-hop and `snoc` constructors above. -/
inductive IsGenerated :
    FiniteMixedSideDistinctPropagationTrace T hclaw F source incoming → Prop
  | start
      (predecessorOccurrence :
        Nonempty (FiniteMixedSideFirstBlockFlankOccurrence T F source incoming))
      (previous_outside_originalHole :
        F.towardEndpointVertex (T.currentSlot source target) ∉
          Set.range
            T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex)
      (center : V)
      (initialIndex : Fin
        T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card)
      (initial_avoidance :
        initialIndex ∉
            (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
              (F.towardEndpointVertex (T.currentSlot source target)) ∧
          initialIndex ≠ T.targetCloneIndexOfIncoming hclaw incoming ∧
          ¬CyclicAdjacent
            (T.targetCloneIndexOfIncoming hclaw incoming) initialIndex)
      (clone_avoids_previousNeighbors :
        T.targetCloneIndexOfIncoming hclaw incoming ∉
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
            (F.towardEndpointVertex (T.currentSlot source target)))
      (adj_previous :
        G.Adj center
          (F.towardEndpointVertex (T.currentSlot source target)))
      (adj_initial :
        G.Adj center
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
            initialIndex))
      (adj_stoppingCloneCenter :
        G.Adj center
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
            (T.targetCloneIndexOfIncoming hclaw incoming))) :
      IsGenerated
        (FiniteMixedSideDistinctPropagationTrace.start
          predecessorOccurrence previous_outside_originalHole center
          initialIndex initial_avoidance clone_avoids_previousNeighbors
          adj_previous adj_initial adj_stoppingCloneCenter)
  | snoc
      {X : FiniteMixedSideDistinctPropagationTrace
        T hclaw F source incoming}
      (generated : IsGenerated X)
      (block : Fin
        (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
          source).blockCount)
      (nextIndex : Fin
        T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.card)
      (current_mem_path :
        T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
            (X.carriedIndex X.finalIndex) ∈
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
            source).path block)
      (next_mem_path :
        T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
            nextIndex ∈
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.ordered
            source).path block)
      (next_avoidance :
        nextIndex ∉
            (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole).neighborIndexSet
              (F.towardEndpointVertex (T.currentSlot source target)) ∧
          nextIndex ≠ T.targetCloneIndexOfIncoming hclaw incoming ∧
          ¬CyclicAdjacent
            (T.targetCloneIndexOfIncoming hclaw incoming) nextIndex)
      (adj_next :
        G.Adj X.center
          (T.execution.toInitializationFiniteMixedSideOSExecutionData.originalHole.vertex
            nextIndex)) :
      IsGenerated
        (X.snoc block nextIndex current_mem_path next_mem_path
          next_avoidance adj_next)

end FiniteMixedSideDistinctPropagationTrace

/-- Unequal-centre propagation data whose bounded trace must be generated by
the literal start and hop constructors. -/
structure FiniteMixedSideDistinctCenterGeneratedPropagationData
    (T : I.InitializationFiniteMixedSideTerminalCoreData)
    (D : FiniteMixedSideInitializationTerminalTetherData T)
    (hclaw : G.IsClawFree) : Prop where
  trace :
    ∀ ⦃source source' target : I.Node⦄
      (hne : source ≠ source')
      (incoming : I.graph.Arc source target)
      (incoming' : I.graph.Arc source' target)
      (hsource :
        (T.terminalPath target).obstructionEndpoint
            (T.currentSlot source target) ≠ (target : V))
      (hsource' :
        (T.terminalPath target).obstructionEndpoint
            (T.currentSlot source' target) ≠ (target : V)),
      let C := D.toInteriorTerminalCloneData hclaw
      let left := C.witnessOfInterior incoming hsource
      let right := C.witnessOfInterior incoming' hsource'
      ∀ hcenter : left.center ≠ right.center,
        ∃ F : FiniteMixedSideTerminalTwoStepFlanks T target,
          match T.positiveDistinctSide_of_terminalClone_center_ne
              left right hcenter with
          | .left _ =>
              ∃ X : FiniteMixedSideDistinctPropagationTrace
                  T hclaw F source incoming,
                FiniteMixedSideDistinctPropagationTrace.IsGenerated X
          | .right _ =>
              ∃ X : FiniteMixedSideDistinctPropagationTrace
                  T hclaw F source' incoming',
                FiniteMixedSideDistinctPropagationTrace.IsGenerated X

namespace FiniteMixedSideDistinctCenterGeneratedPropagationData

variable {T : I.InitializationFiniteMixedSideTerminalCoreData}
  {D : FiniteMixedSideInitializationTerminalTetherData T}
  {hclaw : G.IsClawFree}

/-- Forget only the constructor-generation proof to recover the existing
bounded trace interface. -/
noncomputable def toTraceData
    (A : FiniteMixedSideDistinctCenterGeneratedPropagationData T D hclaw) :
    FiniteMixedSideDistinctCenterPropagationTraceData T D hclaw where
  trace := by
    classical
    intro source source' target hne incoming incoming' hsource hsource'
    dsimp
    intro hcenter
    have hgenerated :=
      A.trace hne incoming incoming' hsource hsource' hcenter
    obtain ⟨F, htrace⟩ := hgenerated
    cases hside : T.positiveDistinctSide_of_terminalClone_center_ne
        (D.toInteriorTerminalCloneData hclaw |>.witnessOfInterior incoming hsource)
        (D.toInteriorTerminalCloneData hclaw |>.witnessOfInterior incoming' hsource')
        hcenter with
    | left hpos =>
        have hleft :
            ∃ X : FiniteMixedSideDistinctPropagationTrace
                T hclaw F source incoming,
              FiniteMixedSideDistinctPropagationTrace.IsGenerated X := by
          simpa [hside] using htrace
        obtain ⟨X, _generated⟩ := hleft
        exact ⟨F, Or.inl ⟨X⟩⟩
    | right hpos =>
        have hright :
            ∃ X : FiniteMixedSideDistinctPropagationTrace
                T hclaw F source' incoming',
              FiniteMixedSideDistinctPropagationTrace.IsGenerated X := by
          simpa [hside] using htrace
        obtain ⟨X, _generated⟩ := hright
        exact ⟨F, Or.inr ⟨X⟩⟩

end FiniteMixedSideDistinctCenterGeneratedPropagationData

end ObstructionSearchInitialization
end FixedPairingPathFamily
end SimpleGraph

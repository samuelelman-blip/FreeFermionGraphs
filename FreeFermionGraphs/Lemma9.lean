import FreeFermionGraphs.NeighborhoodDeformationAll

/-!
# Deformation closures and Lemma 9

The deformation closure is the reflexive-transitive closure of reversible
single-vertex deformation steps between even-hole carriers.  Since one step
preserves the open neighborhood, so does every finite deformation sequence.
-/

universe u

variable {V : Type u}

namespace SimpleGraph

variable {G : SimpleGraph V}

/-- Two carriers differ by one single-vertex deformation of an alternating
even hole.  Both orientations are included, reflecting reversibility. -/
def EvenHoleDeformationStep (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∃ (k : Nat) (C : EvenHoleLabeling G k) (s : V) (i : Fin k),
    C.CloneAt s i ∧
      ((A = C.carrier ∧ B = C.deformedCarrier s i) ∨
       (A = C.deformedCarrier s i ∧ B = C.carrier))

/-- The deformation-closure relation generated by single-vertex
deformations. -/
inductive InEvenHoleDeformationClosure (G : SimpleGraph V) :
    Set V → Set V → Prop
  | refl (A : Set V) : InEvenHoleDeformationClosure G A A
  | tail {A B C : Set V} :
      InEvenHoleDeformationClosure G A B →
      EvenHoleDeformationStep G B C →
      InEvenHoleDeformationClosure G A C

/-- A single reversible deformation step preserves the open neighborhood. -/
theorem EvenHoleDeformationStep.openNeighborhood_eq
    {A B : Set V} (hstep : EvenHoleDeformationStep G A B)
    (hclaw : G.IsClawFree) :
    G.openNeighborhood A = G.openNeighborhood B := by
  rcases hstep with ⟨k, C, s, i, h, hforward | hbackward⟩
  · rcases hforward with ⟨rfl, rfl⟩
    exact (h.openNeighborhood_deformedCarrier_eq hclaw).symm
  · rcases hbackward with ⟨rfl, rfl⟩
    exact h.openNeighborhood_deformedCarrier_eq hclaw

/-- Lemma 9 of the paper, in equality form: all even-hole carriers in one
deformation closure have the same open neighborhood. -/
theorem InEvenHoleDeformationClosure.openNeighborhood_eq
    {A B : Set V} (hclosure : InEvenHoleDeformationClosure G A B)
    (hclaw : G.IsClawFree) :
    G.openNeighborhood A = G.openNeighborhood B := by
  induction hclosure with
  | refl A => rfl
  | tail hAB hBC ih =>
      exact ih.trans (hBC.openNeighborhood_eq hclaw)

/-- Paper-facing membership form of Lemma 9. -/
theorem lemma9 {A B : Set V}
    (hclosure : InEvenHoleDeformationClosure G A B)
    (hclaw : G.IsClawFree) {t : V}
    (ht : t ∈ G.openNeighborhood A) :
    t ∈ G.openNeighborhood B := by
  exact hclosure.openNeighborhood_eq hclaw ▸ ht

end SimpleGraph

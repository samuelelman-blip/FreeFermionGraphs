/-!
# Joint spectral projections of commuting Hermitian matrices

Linear-algebra input for the statement of v1 Theorem 2 (Chapman--Elman--Mann,
arXiv:2305.15625v1, `main.tex` L1258-1262): the cycle symmetries `J_<C0>` are mutually commuting
Hermitian operators, and `{Π_J}_J` is "a complete set of projectors onto the mutual eigenspaces
of `{J_<C0>}`".  The manuscript uses this standard fact without proof; this file proves it for
finite families of commuting Hermitian complex matrices.  It is a statement about matrices only,
with no premise beyond the manuscript setup, so it carries an unqualified name.

The main result is `exists_joint_spectral_projections`: for pairwise commuting Hermitian
`J_i`, there is a finite set `Λ` of real tuples and Hermitian idempotent nonzero matrices `P_l`
(`l ∈ Λ`) which are pairwise orthogonal, sum to `1`, satisfy `J_i P_l = l_i P_l`, are central
with respect to the commutant of the family, and such that `l ∈ Λ` iff the joint eigenspace for
`l` is nonzero.  The last conjunct is the exact non-degeneracy bookkeeping needed downstream.

## Proof overview

Mathlib's spectral theorem for Hermitian matrices lives in `Mathlib.Analysis`, which is not part
of the build of this repository, so the proof here is self-contained and needs only
`Matrix`, `Polynomial` and `Lagrange` infrastructure.

1. `exists_nodal_annihilator`: every Hermitian `A` is annihilated by `∏_{μ ∈ S} (X - μ)` for a
   finite set `S` of reals (diagonalisable with real spectrum).  The existence of one real
   eigenvector comes from maximising the Rayleigh quotient without compactness
   (`exists_eigenvector_max`); the induction removes eigenvalues one at a time inside corners
   `E`, i.e. Hermitian idempotents commuting with `A` (`nodal_step`).
2. Lagrange basis polynomials of `S` give the spectral idempotents of one matrix
   (`aeval_basisPoly_mul`, `aeval_basisPoly_sum`, `mul_aeval_basisPoly`).
3. All idempotents live in the commutative subalgebra generated by the family, where
   `P_l = ∏_i p_{i, l_i}(J_i)` and the identities reduce to `Finset.prod_univ_sum`
   (`prod_basis_relations`).
-/

open Matrix

namespace JointSpectralProjections

variable {n : Type*} [Fintype n]

/-- The real part `Re (x* B y)` of the sesquilinear pairing of `x, y ∈ ℂ^n` defined by the
matrix `B`. -/
noncomputable def pair (B : Matrix n n ℂ) (x y : n → ℂ) : ℝ :=
  (star x ⬝ᵥ B.mulVec y).re

/-- `pair` is additive in its second argument. -/
theorem pair_add_right (B : Matrix n n ℂ) (x y z : n → ℂ) :
    pair B x (y + z) = pair B x y + pair B x z := by
  simp [pair, Matrix.mulVec_add, dotProduct_add]

/-- `pair` is additive in its first argument. -/
theorem pair_add_left (B : Matrix n n ℂ) (x y z : n → ℂ) :
    pair B (x + y) z = pair B x z + pair B y z := by
  simp [pair, star_add, add_dotProduct]

/-- `pair` is real-homogeneous in its second argument. -/
theorem pair_smul_right (B : Matrix n n ℂ) (t : ℝ) (x y : n → ℂ) :
    pair B x (t • y) = t * pair B x y := by
  simp [pair, Matrix.mulVec_smul, dotProduct_smul]

/-- `pair` is real-homogeneous in its first argument. -/
theorem pair_smul_left (B : Matrix n n ℂ) (t : ℝ) (x y : n → ℂ) :
    pair B (t • x) y = t * pair B x y := by
  simp [pair, star_smul, smul_dotProduct]

/-- For a Hermitian matrix `B`, `pair B` is symmetric. -/
theorem pair_comm {B : Matrix n n ℂ} (hB : B.IsHermitian) (x y : n → ℂ) :
    pair B y x = pair B x y := by
  have h : star y ⬝ᵥ B.mulVec x = star (star x ⬝ᵥ B.mulVec y) := by
    simp only [dotProduct, Matrix.mulVec, star_sum, star_mul, Pi.star_apply, star_star,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [← hB.apply i j]
    simp only [star_star]
    ring
  simp [pair, h]

variable [DecidableEq n]

/-- `pair 1 x x = ∑_j |x_j|²`. -/
theorem pair_one_self (x : n → ℂ) :
    pair 1 x x = ∑ j, ((x j).re ^ 2 + (x j).im ^ 2) := by
  simp [pair, dotProduct, Complex.re_sum, Complex.mul_re, sq]

/-- The squared norm `pair 1 x x` is nonnegative. -/
theorem pair_one_self_nonneg (x : n → ℂ) : 0 ≤ pair 1 x x := by
  rw [pair_one_self]
  exact Finset.sum_nonneg fun j _ => by positivity

/-- A vector of zero squared norm vanishes. -/
theorem eq_zero_of_pair_one_self {x : n → ℂ} (h : pair 1 x x = 0) : x = 0 := by
  rw [pair_one_self] at h
  have := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => by positivity)).1 h
  funext j
  have hj := this j (Finset.mem_univ j)
  have h1 : (x j).re = 0 := by nlinarith [sq_nonneg (x j).re, sq_nonneg (x j).im]
  have h2 : (x j).im = 0 := by nlinarith [sq_nonneg (x j).re, sq_nonneg (x j).im]
  exact Complex.ext h1 h2

/-- The squared norm of `C x` is the quadratic form of `Cᴴ C`. -/
theorem pair_mulVec_self (C : Matrix n n ℂ) (x : n → ℂ) :
    pair 1 (C.mulVec x) (C.mulVec x) = pair (Cᴴ * C) x x := by
  simp only [pair, Matrix.one_mulVec, Matrix.star_mulVec, ← Matrix.mulVec_mulVec]
  rw [← Matrix.dotProduct_mulVec]

/-- Real-valued quadratic forms on `ℂ^n` are bounded by a constant times the squared norm. -/
theorem exists_pair_le (D : Matrix n n ℂ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x : n → ℂ, pair D x x ≤ K * pair 1 x x := by
  refine ⟨∑ j, ∑ k, (|(D j k).re| + |(D j k).im|),
    Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun k _ => by positivity, fun x => ?_⟩
  have hN : ∀ j, (x j).re ^ 2 + (x j).im ^ 2 ≤ pair 1 x x := by
    intro j
    rw [pair_one_self]
    exact Finset.single_le_sum (f := fun j => (x j).re ^ 2 + (x j).im ^ 2)
      (fun i _ => by positivity) (Finset.mem_univ j)
  have hterm : ∀ j k, (star (x j) * (D j k * x k)).re ≤
      (|(D j k).re| + |(D j k).im|) * pair 1 x x := by
    intro j k
    have hj := hN j
    have hk := hN k
    set M := pair 1 x x
    have hu : |(x j).re * (x k).re + (x j).im * (x k).im| ≤ M := by
      rw [abs_le]
      constructor <;> nlinarith [sq_nonneg ((x j).re + (x k).re), sq_nonneg ((x j).im + (x k).im),
        sq_nonneg ((x j).re - (x k).re), sq_nonneg ((x j).im - (x k).im)]
    have hv : |(x j).im * (x k).re - (x j).re * (x k).im| ≤ M := by
      rw [abs_le]
      constructor <;> nlinarith [sq_nonneg ((x j).im + (x k).re), sq_nonneg ((x j).re + (x k).im),
        sq_nonneg ((x j).im - (x k).re), sq_nonneg ((x j).re - (x k).im)]
    have hexp : (star (x j) * (D j k * x k)).re =
        (D j k).re * ((x j).re * (x k).re + (x j).im * (x k).im) +
        (D j k).im * ((x j).im * (x k).re - (x j).re * (x k).im) := by
      simp [Complex.mul_re, Complex.mul_im]
      ring
    rw [hexp]
    have h1 : (D j k).re * ((x j).re * (x k).re + (x j).im * (x k).im) ≤ |(D j k).re| * M :=
      calc _ ≤ |(D j k).re * ((x j).re * (x k).re + (x j).im * (x k).im)| := le_abs_self _
        _ = |(D j k).re| * |(x j).re * (x k).re + (x j).im * (x k).im| := abs_mul _ _
        _ ≤ |(D j k).re| * M := mul_le_mul_of_nonneg_left hu (abs_nonneg _)
    have h2 : (D j k).im * ((x j).im * (x k).re - (x j).re * (x k).im) ≤ |(D j k).im| * M :=
      calc _ ≤ |(D j k).im * ((x j).im * (x k).re - (x j).re * (x k).im)| := le_abs_self _
        _ = |(D j k).im| * |(x j).im * (x k).re - (x j).re * (x k).im| := abs_mul _ _
        _ ≤ |(D j k).im| * M := mul_le_mul_of_nonneg_left hv (abs_nonneg _)
    linarith
  calc pair D x x = ∑ j, ∑ k, (star (x j) * (D j k * x k)).re := by
        simp [pair, dotProduct, Matrix.mulVec, Complex.re_sum, Finset.mul_sum]
    _ ≤ ∑ j, ∑ k, (|(D j k).re| + |(D j k).im|) * pair 1 x x :=
        Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun k _ => hterm j k
    _ = _ := by simp [Finset.sum_mul]

omit [DecidableEq n] in
/-- Cauchy--Schwarz for a positive semidefinite Hermitian form. -/
theorem pair_sq_le {B : Matrix n n ℂ} (hB : B.IsHermitian) (hpos : ∀ z, 0 ≤ pair B z z)
    (x y : n → ℂ) : pair B x y ^ 2 ≤ pair B x x * pair B y y := by
  have key : ∀ t : ℝ, 0 ≤ pair B y y * (t * t) + (2 * pair B x y) * t + pair B x x := by
    intro t
    have h := hpos (x + t • y)
    rw [pair_add_left, pair_add_right, pair_add_right, pair_smul_left, pair_smul_right,
      pair_smul_left, pair_smul_right, pair_comm hB x y] at h
    linarith
  have hd := discrim_le_zero key
  unfold discrim at hd
  nlinarith

/-- A nonzero vector has positive squared norm. -/
theorem pair_one_pos {x : n → ℂ} (hx : x ≠ 0) : 0 < pair 1 x x :=
  lt_of_le_of_ne (pair_one_self_nonneg x) fun h => hx (eq_zero_of_pair_one_self h.symm)

/-- A Hermitian matrix on a nonzero space has an eigenvector whose real eigenvalue is the
maximum of the Rayleigh quotient `Re (y* A y) / Re (y* y)`.

The maximum is obtained as a supremum, and the supremum is shown to be attained as an
eigenvalue by a Cauchy--Schwarz estimate for the positive semidefinite form `lam - A` (no
compactness argument is needed). -/
theorem exists_eigenvector_max {A : Matrix n n ℂ} (hA : A.IsHermitian)
    (hne : ∃ y : n → ℂ, y ≠ 0) :
    ∃ (lam : ℝ) (x : n → ℂ), x ≠ 0 ∧ A.mulVec x = lam • x ∧
      ∀ y, pair A y y ≤ lam * pair 1 y y := by
  obtain ⟨K, hK0, hK⟩ := exists_pair_le A
  set R : Set ℝ := {r | ∃ y : n → ℂ, y ≠ 0 ∧ r = pair A y y / pair 1 y y} with hR
  have hRne : R.Nonempty := by
    obtain ⟨y, hy⟩ := hne
    exact ⟨_, y, hy, rfl⟩
  have hRbdd : BddAbove R := ⟨K, by
    rintro r ⟨y, hy, rfl⟩
    rw [div_le_iff₀ (pair_one_pos hy)]
    exact hK y⟩
  set lam := sSup R with hlamdef
  have hlam : ∀ y, pair A y y ≤ lam * pair 1 y y := by
    intro y
    by_cases hy : y = 0
    · subst hy
      simp [pair]
    · have := le_csSup hRbdd ⟨y, hy, rfl⟩
      rwa [div_le_iff₀ (pair_one_pos hy)] at this
  set B : Matrix n n ℂ := lam • (1 : Matrix n n ℂ) - A with hBdef
  have hBherm : B.IsHermitian := by
    simp [hBdef, Matrix.IsHermitian, Matrix.conjTranspose_sub, Matrix.conjTranspose_smul,
      hA.eq]
  have hpairB : ∀ x y, pair B x y = lam * pair 1 x y - pair A x y := by
    intro x y
    simp [hBdef, pair, Matrix.sub_mulVec, Matrix.smul_mulVec, dotProduct_sub, dotProduct_smul]
  have hposB : ∀ z, 0 ≤ pair B z z := fun z => by rw [hpairB]; linarith [hlam z]
  have hker : ∃ x : n → ℂ, x ≠ 0 ∧ B.mulVec x = 0 := by
    by_contra hcon
    push Not at hcon
    have hinj : Function.Injective B.mulVec := by
      intro x y hxy
      have : B.mulVec (x - y) = 0 := by rw [Matrix.mulVec_sub, hxy, sub_self]
      by_contra hne'
      exact hcon _ (sub_ne_zero.2 hne') this
    have hUnit : IsUnit B := Matrix.mulVec_injective_iff_isUnit.1 hinj
    have hBC : B * B⁻¹ = 1 := Matrix.mul_nonsing_inv _ ((Matrix.isUnit_iff_isUnit_det _).1 hUnit)
    obtain ⟨K', hK'0, hK'⟩ := exists_pair_le (B⁻¹ᴴ * B⁻¹)
    have hδ : ∀ x : n → ℂ, x ≠ 0 → pair 1 x x ≤ (K' + 1) * pair B x x := by
      intro x hx
      set y := B⁻¹.mulVec x with hy
      have hBy : B.mulVec y = x := by
        rw [hy, Matrix.mulVec_mulVec, hBC, Matrix.one_mulVec]
      have hxy : pair B x y = pair 1 x x := by simp [pair, hBy]
      have hyy : pair B y y = pair 1 y x := by simp [pair, hBy]
      have hN : pair 1 y y ≤ K' * pair 1 x x := by
        rw [hy, pair_mulVec_self]; exact hK' x
      have hcs1 := pair_sq_le hBherm hposB x y
      have hcs2 := pair_sq_le (B := 1) Matrix.isHermitian_one
        (fun z => pair_one_self_nonneg z) y x
      rw [hxy] at hcs1
      rw [hyy] at hcs1
      have ha := pair_one_pos hx
      set a := pair 1 x x with ha_def
      set q := pair B x x with hq
      set s := pair 1 y x with hs
      have hq0 : 0 ≤ q := hposB x
      have hs0 : 0 ≤ s := by rw [← hyy]; exact hposB y
      have hs2 : s ^ 2 ≤ K' * a ^ 2 := by
        have h1 : pair 1 y x ^ 2 ≤ pair 1 y y * pair 1 x x := hcs2
        have hN0 : 0 ≤ pair 1 y y := pair_one_self_nonneg y
        nlinarith
      have h4 : (a ^ 2) ^ 2 ≤ (q * s) ^ 2 := by
        apply pow_le_pow_left₀ (by positivity)
        nlinarith
      have h5 : a ^ 2 * a ^ 2 ≤ K' * q ^ 2 * a ^ 2 := by
        have : (q * s) ^ 2 = q ^ 2 * s ^ 2 := by ring
        nlinarith [sq_nonneg q]
      have h6 : a ^ 2 ≤ K' * q ^ 2 := le_of_mul_le_mul_right h5 (by positivity)
      by_contra hcon
      push Not at hcon
      have h7 : ((K' + 1) * q) ^ 2 < a ^ 2 := by
        apply pow_lt_pow_left₀ hcon (by positivity) (by norm_num)
      nlinarith [sq_nonneg q, sq_nonneg K']
    have hbound : ∀ r ∈ R, r ≤ lam - 1 / (K' + 1) := by
      rintro r ⟨x, hx, rfl⟩
      have hpos := pair_one_pos hx
      rw [div_le_iff₀ hpos]
      have h := hδ x hx
      have h2 := hpairB x x
      have hK1 : 0 < K' + 1 := by linarith
      have : 1 / (K' + 1) * pair 1 x x ≤ pair B x x := by
        rw [one_div, inv_mul_le_iff₀ hK1]; exact h
      nlinarith
    have := csSup_le hRne hbound
    have hK1 : 0 < K' + 1 := by linarith
    have : 0 < 1 / (K' + 1) := by positivity
    linarith
  obtain ⟨x, hx0, hBx⟩ := hker
  refine ⟨lam, x, hx0, ?_, hlam⟩
  have : A.mulVec x = lam • x := by
    have h := hBx
    simp only [hBdef, Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec] at h
    exact (sub_eq_zero.1 h).symm
  exact this

/-! ### Polynomials in a Hermitian matrix -/

open Polynomial

/-- Real polynomials in `a` commute with everything commuting with `a`. -/
theorem commute_aeval' {M : Type*} [Ring M] [Algebra ℝ M] {a b : M} (h : Commute a b)
    (f : ℝ[X]) : Commute (aeval a f) b := by
  induction f using Polynomial.induction_on' with
  | add p q hp hq => simpa [map_add] using hp.add_left hq
  | monomial k r =>
    rw [aeval_monomial]
    exact (Algebra.commute_algebraMap_left r b).mul_left (h.pow_left k)

/-- Polynomials in one element commute with each other. -/
theorem aeval_commute_aeval {M : Type*} [Ring M] [Algebra ℝ M] (a : M) (f g : ℝ[X]) :
    aeval a f * aeval a g = aeval a g * aeval a f := by
  rw [← map_mul, ← map_mul, mul_comm]

/-- Real polynomials in a Hermitian matrix are Hermitian. -/
theorem isHermitian_aeval {A : Matrix n n ℂ} (hA : A.IsHermitian) (f : ℝ[X]) :
    (aeval A f).IsHermitian := by
  induction f using Polynomial.induction_on' with
  | add p q hp hq => simpa [map_add] using hp.add hq
  | monomial k r =>
    rw [aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
    exact (hA.pow k).smul (IsSelfAdjoint.all r)

/-- A real polynomial in `A` acts on an eigenvector by its value at the eigenvalue. -/
theorem aeval_mulVec_of_mulVec_eq {A : Matrix n n ℂ} {v : n → ℂ} {ν : ℝ}
    (hv : A.mulVec v = ν • v) (f : ℝ[X]) :
    (aeval A f).mulVec v = (f.eval ν) • v := by
  induction f using Polynomial.induction_on' with
  | add p q hp hq =>
    simp [map_add, Matrix.add_mulVec, hp, hq, add_smul]
  | monomial k r =>
    have hpow : ∀ m : ℕ, (A ^ m).mulVec v = (ν ^ m) • v := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [pow_succ, ← Matrix.mulVec_mulVec, hv, Matrix.mulVec_smul, ih, smul_smul, pow_succ]
        ring_nf
    rw [aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul,
      Matrix.smul_mulVec, hpow, smul_smul]
    simp

/-- A Hermitian matrix with `B * B = 0` vanishes. -/
theorem eq_zero_of_isHermitian_mul_self {B : Matrix n n ℂ} (hB : B.IsHermitian)
    (h : B * B = 0) : B = 0 := by
  rw [Matrix.ext_iff_mulVec]
  intro v
  have h0 : pair 1 (B.mulVec v) (B.mulVec v) = 0 := by
    rw [pair_mulVec_self, hB.eq, h]
    simp [pair]
  simpa using eq_zero_of_pair_one_self h0

/-- A Hermitian matrix `A` has an eigenvector (with real eigenvalue) in the range of every
nonzero Hermitian idempotent `E` commuting with `A`.

The idempotent is removed by shifting `A` to `A E - c (1 - E)` with `c` large, so that the
maximal Rayleigh eigenvector (`exists_eigenvector_max`) lies in the range of `E`. -/
theorem exists_eigenvector_range {A E : Matrix n n ℂ} (hA : A.IsHermitian) (hE : E.IsHermitian)
    (hEE : E * E = E) (hAE : Commute A E) (hE0 : E ≠ 0) :
    ∃ (lam : ℝ) (x : n → ℂ), x ≠ 0 ∧ E.mulVec x = x ∧ A.mulVec x = lam • x := by
  have hAE' : A * E = E * A := hAE.eq
  obtain ⟨e, he⟩ : ∃ e : n → ℂ, E.mulVec e ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hE0 (Matrix.ext_iff_mulVec.2 fun v => by simpa using hcon v)
  set x₁ := E.mulVec e with hx₁
  have hEx₁ : E.mulVec x₁ = x₁ := by rw [hx₁, Matrix.mulVec_mulVec, hEE]
  set ρ₁ := pair A x₁ x₁ / pair 1 x₁ x₁ with hρ₁
  set c : ℝ := |ρ₁| + 1 with hc
  set A' : Matrix n n ℂ := A * E - c • (1 - E) with hA'def
  have hA' : A'.IsHermitian := by
    have h1 : (A * E).IsHermitian := by
      have : (A * E)ᴴ = A * E := by
        rw [Matrix.conjTranspose_mul, hE.eq, hA.eq, ← hAE']
      exact this
    exact h1.sub ((Matrix.isHermitian_one.sub hE).smul (IsSelfAdjoint.all c))
  obtain ⟨lam, x, hx0, hAx, hmax⟩ := exists_eigenvector_max hA' ⟨x₁, he⟩
  have hA'x₁ : A'.mulVec x₁ = A.mulVec x₁ := by
    simp [hA'def, Matrix.sub_mulVec, Matrix.smul_mulVec, hEx₁,
      ← Matrix.mulVec_mulVec]
  have hge : ρ₁ ≤ lam := by
    have h := hmax x₁
    have : pair A' x₁ x₁ = pair A x₁ x₁ := by simp [pair, hA'x₁]
    rw [this] at h
    rw [hρ₁, div_le_iff₀ (pair_one_pos he)]
    exact h
  have hlc : 0 < lam + c := by
    have := neg_abs_le ρ₁
    linarith [abs_nonneg ρ₁]
  have hcomp : (1 - E) * A' = (-c) • (1 - E) := by
    have h1 : (1 - E) * (A * E) = 0 := by
      rw [sub_mul, one_mul, ← mul_assoc, ← hAE', mul_assoc, hEE, sub_self]
    have h2 : (1 - E) * (1 - E) = 1 - E := by
      rw [sub_mul, mul_sub, mul_sub, one_mul, mul_one, hEE, one_mul]
      abel
    rw [hA'def, mul_sub, h1, mul_smul_comm, h2, zero_sub, neg_smul]
  have h1E : (1 - E).mulVec x = 0 := by
    have h := congrArg (fun M => M.mulVec x) hcomp
    simp only [← Matrix.mulVec_mulVec, hAx, Matrix.mulVec_smul, Matrix.smul_mulVec] at h
    have h' : (lam + c) • (1 - E).mulVec x = 0 := by
      rw [add_smul, h, neg_smul, neg_add_cancel]
    rcases smul_eq_zero.1 h' with h0 | h0
    · exact absurd h0 hlc.ne'
    · exact h0
  have hEx : E.mulVec x = x := by
    rw [Matrix.sub_mulVec, Matrix.one_mulVec, sub_eq_zero] at h1E
    exact h1E.symm
  refine ⟨lam, x, hx0, hEx, ?_⟩
  have : A'.mulVec x = A.mulVec x := by
    simp [hA'def, Matrix.sub_mulVec, Matrix.smul_mulVec, hEx, ← Matrix.mulVec_mulVec]
  rw [← this, hAx]


/-- Inductive step of `exists_nodal_annihilator_corner`: if `g(A) E = 0` with `deg g ≤ N + 1`,
then `E` can be split as `E₁ + P` where `P` is the spectral projection of `A * E` at an
eigenvalue `lam`, and the annihilating polynomial of `A` on `E₁` has degree `≤ N`. -/
theorem nodal_step {A E : Matrix n n ℂ} (hA : A.IsHermitian) (hE : E.IsHermitian)
    (hEE : E * E = E) (hAE : Commute A E) (N : ℕ)
    (ih : ∀ E' : Matrix n n ℂ, E'.IsHermitian → E' * E' = E' → Commute A E' →
      (∃ g : ℝ[X], g ≠ 0 ∧ g.natDegree ≤ N ∧ aeval A g * E' = 0) →
      ∃ S : Finset ℝ, aeval A (∏ μ ∈ S, (X - C μ)) * E' = 0)
    (g : ℝ[X]) (hg0 : g ≠ 0) (hgdeg : g.natDegree ≤ N + 1) (hgE : aeval A g * E = 0) :
    ∃ S : Finset ℝ, aeval A (∏ μ ∈ S, (X - C μ)) * E = 0 := by
  have hAE' : A * E = E * A := hAE.eq
  by_cases hE0 : E = 0
  · exact ⟨∅, by simp [hE0]⟩
  obtain ⟨lam, x, hx0, hEx, hAx⟩ := exists_eigenvector_range hA hE hEE hAE hE0
  have hroot : g.IsRoot lam := by
    have h1 : (aeval A g * E).mulVec x = 0 := by rw [hgE]; simp
    rw [← Matrix.mulVec_mulVec, hEx, aeval_mulVec_of_mulVec_eq hAx] at h1
    rcases smul_eq_zero.1 h1 with h | h
    · exact h
    · exact absurd h hx0
  set t := g /ₘ (X - C lam) with ht
  have hgt : (X - C lam) * t = g := mul_divByMonic_eq_iff_isRoot.2 hroot
  have ht0 : t ≠ 0 := by
    rintro h
    rw [h, mul_zero] at hgt
    exact hg0 hgt.symm
  have htdeg : t.natDegree ≤ N := by
    have : g.natDegree = t.natDegree + 1 := by
      rw [← hgt, natDegree_mul (X_sub_C_ne_zero lam) ht0, natDegree_X_sub_C]
      ring
    omega
  set L : Matrix n n ℂ := aeval A (X - C lam) with hL
  set a : Matrix n n ℂ := aeval A t with ha
  have haH : a.IsHermitian := isHermitian_aeval hA t
  have haE : a * E = E * a := (commute_aeval' hAE t).eq
  have haA : a * A = A * a := (commute_aeval' (Commute.refl A) t).eq
  have hLT : L * (a * E) = 0 := by
    rw [← mul_assoc, hL, ha, ← map_mul, hgt]
    exact hgE
  by_cases htl : t.eval lam = 0
  · -- repeated root: use the Hermitian nilpotent argument
    have hts : (X - C lam) * (t /ₘ (X - C lam)) = t := mul_divByMonic_eq_iff_isRoot.2 htl
    set s := t /ₘ (X - C lam) with hs
    have hB : (a * E) * (a * E) = 0 := by
      have h1 : (a * E) * (a * E) = aeval A (t * t) * E := by
        calc (a * E) * (a * E) = a * (E * a) * E := by noncomm_ring
          _ = a * (a * E) * E := by rw [haE]
          _ = a * a * (E * E) := by noncomm_ring
          _ = a * a * E := by rw [hEE]
          _ = aeval A (t * t) * E := by rw [map_mul]
      have h2 : t * t = s * g := by
        calc t * t = t * ((X - C lam) * s) := by rw [hts]
          _ = s * ((X - C lam) * t) := by ring
          _ = s * g := by rw [hgt]
      rw [h1, h2, map_mul, mul_assoc, hgE, mul_zero]
    have hBH : (a * E).IsHermitian := by
      have : (a * E)ᴴ = a * E := by
        rw [Matrix.conjTranspose_mul, hE.eq, haH.eq, ← haE]
      exact this
    have h0 : a * E = 0 := eq_zero_of_isHermitian_mul_self hBH hB
    exact ih E hE hEE hAE ⟨t, ht0, htdeg, h0⟩
  · -- simple root
    set τ : ℝ := t.eval lam with hτ
    have hτ0 : τ ≠ 0 := htl
    have htq : (X - C lam) * ((t - C τ) /ₘ (X - C lam)) = t - C τ := by
      apply mul_divByMonic_eq_iff_isRoot.2
      simp [hτ]
    set q := (t - C τ) /ₘ (X - C lam) with hq
    set Q : Matrix n n ℂ := aeval A q with hQ
    have hdecomp : a = τ • (1 : Matrix n n ℂ) + L * Q := by
      have : t = C τ + (X - C lam) * q := by rw [htq]; ring
      rw [ha, this]
      simp [hL, hQ, map_add, map_mul, Algebra.algebraMap_eq_smul_one]
    have hLQ : L * Q = Q * L := aeval_commute_aeval A _ _
    obtain ⟨T, hT⟩ : ∃ T : Matrix n n ℂ, T = a * E := ⟨_, rfl⟩
    have hLT' : L * T = 0 := by rw [hT]; exact hLT
    have haT : a * T = τ • T := by
      rw [hdecomp]
      calc (τ • (1 : Matrix n n ℂ) + L * Q) * T = τ • T + L * Q * T := by
            rw [add_mul, smul_mul_assoc, one_mul]
        _ = τ • T + Q * (L * T) := by rw [hLQ, mul_assoc]
        _ = τ • T := by rw [hLT']; simp
    have hTT : T * T = τ • T := by
      calc T * T = a * (E * a) * E := by rw [hT]; noncomm_ring
        _ = a * (a * E) * E := by rw [haE]
        _ = a * a * (E * E) := by noncomm_ring
        _ = a * a * E := by rw [hEE]
        _ = a * T := by rw [hT]; noncomm_ring
        _ = τ • T := haT
    have hET : E * T = T := by
      rw [hT, ← mul_assoc, ← haE, mul_assoc, hEE]
    have hTE : T * E = T := by
      rw [hT, mul_assoc, hEE]
    have hTH : T.IsHermitian := by
      have : Tᴴ = T := by
        rw [hT, Matrix.conjTranspose_mul, hE.eq, haH.eq, ← haE]
      exact this
    have hTA : A * T = T * A := by
      rw [hT]
      calc A * (a * E) = (A * a) * E := by rw [mul_assoc]
        _ = (a * A) * E := by rw [haA]
        _ = a * (A * E) := by rw [mul_assoc]
        _ = a * (E * A) := by rw [hAE']
        _ = a * E * A := by rw [mul_assoc]
    set P : Matrix n n ℂ := τ⁻¹ • T with hP
    have hPP : P * P = P := by
      rw [hP, smul_mul_assoc, mul_smul_comm, hTT, smul_smul, smul_smul]
      congr 1
      field_simp
    have hEP : E * P = P := by rw [hP, mul_smul_comm, hET]
    have hPE : P * E = P := by rw [hP, smul_mul_assoc, hTE]
    have hPH : P.IsHermitian := hTH.smul (IsSelfAdjoint.all τ⁻¹)
    have hAP : A * P = P * A := by rw [hP, mul_smul_comm, smul_mul_assoc, hTA]
    have hLP : L * P = 0 := by rw [hP, mul_smul_comm, hLT', smul_zero]
    have haP : a * P = T := by
      rw [hP, mul_smul_comm, haT, smul_smul, inv_mul_cancel₀ hτ0, one_smul]
    set E₁ : Matrix n n ℂ := E - P with hE₁
    have hE₁H : E₁.IsHermitian := hE.sub hPH
    have hE₁E₁ : E₁ * E₁ = E₁ := by
      rw [hE₁, sub_mul, mul_sub, mul_sub, hEE, hEP, hPE, hPP]
      abel
    have hAE₁ : Commute A E₁ := by
      show A * E₁ = E₁ * A
      rw [hE₁, mul_sub, sub_mul, hAE', hAP]
    have haE₁ : a * E₁ = 0 := by
      rw [hE₁, mul_sub, haP, hT, sub_self]
    obtain ⟨S₁, hS₁⟩ := ih E₁ hE₁H hE₁E₁ hAE₁ ⟨t, ht0, htdeg, haE₁⟩
    refine ⟨insert lam S₁, ?_⟩
    have hEsplit : E = E₁ + P := by rw [hE₁]; abel
    have hPi_P : aeval A (∏ μ ∈ insert lam S₁, (X - C μ)) * P = 0 := by
      have hprod : ∏ μ ∈ insert lam S₁, (X - C μ) =
          (∏ μ ∈ (insert lam S₁).erase lam, (X - C μ)) * (X - C lam) :=
        (Finset.prod_erase_mul _ _ (Finset.mem_insert_self lam S₁)).symm
      rw [hprod, map_mul, mul_assoc, ← hL, hLP, mul_zero]
    have hPi_E₁ : aeval A (∏ μ ∈ insert lam S₁, (X - C μ)) * E₁ = 0 := by
      by_cases hmem : lam ∈ S₁
      · rw [Finset.insert_eq_of_mem hmem]
        exact hS₁
      · rw [Finset.prod_insert hmem, map_mul, mul_assoc, hS₁, mul_zero]
    rw [hEsplit, mul_add, hPi_E₁, hPi_P, add_zero]


/-- Corner version of `exists_nodal_annihilator`: if `g(A) E = 0` for a nonzero real polynomial
`g`, for a Hermitian idempotent `E` commuting with the Hermitian matrix `A`, then
`∏_{μ ∈ S} (A - μ) E = 0` for a finite set `S` of reals. -/
theorem exists_nodal_annihilator_corner {A : Matrix n n ℂ} (hA : A.IsHermitian) (N : ℕ) :
    ∀ E : Matrix n n ℂ, E.IsHermitian → E * E = E → Commute A E →
      (∃ g : ℝ[X], g ≠ 0 ∧ g.natDegree ≤ N ∧ aeval A g * E = 0) →
      ∃ S : Finset ℝ, aeval A (∏ μ ∈ S, (X - C μ)) * E = 0 := by
  induction N with
  | zero =>
    rintro E hE hEE hAE ⟨g, hg0, hgdeg, hgE⟩
    refine ⟨∅, ?_⟩
    have hg : g = C (g.coeff 0) := eq_C_of_natDegree_le_zero hgdeg
    have hc : g.coeff 0 ≠ 0 := by
      intro h
      rw [h, C_0] at hg
      exact hg0 hg
    rw [hg, aeval_C, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul] at hgE
    have := (smul_eq_zero.1 hgE).resolve_left hc
    simp [this]
  | succ N ih =>
    rintro E hE hEE hAE ⟨g, hg0, hgdeg, hgE⟩
    exact nodal_step hA hE hEE hAE N ih g hg0 hgdeg hgE

/-- Every Hermitian matrix `A` is annihilated by `∏_{μ ∈ S} (X - μ)` for a finite set `S` of
real numbers: `A` is diagonalisable with real spectrum (no repeated roots). -/
theorem exists_nodal_annihilator {A : Matrix n n ℂ} (hA : A.IsHermitian) :
    ∃ S : Finset ℝ, aeval A (∏ μ ∈ S, (X - C μ)) = 0 := by
  haveI : Module.Finite ℝ ℂ := Module.Finite.of_basis Complex.basisOneI
  have hint : IsIntegral ℝ A := IsIntegral.of_finite ℝ A
  obtain ⟨S, hS⟩ := exists_nodal_annihilator_corner hA (minpoly ℝ A).natDegree 1
    Matrix.isHermitian_one (by simp) (Commute.one_right A)
    ⟨minpoly ℝ A, minpoly.ne_zero hint, le_rfl, by simp [minpoly.aeval ℝ A]⟩
  exact ⟨S, by simpa using hS⟩


/-! ### Spectral idempotents of an annihilated element -/

section Generic

variable {M : Type*} [Ring M] [Algebra ℝ M]

/-- Two real polynomials which agree on the roots of an annihilating nodal polynomial agree at
the element. -/
theorem aeval_eq_of_eqOn_nodal {x : M} {S : Finset ℝ}
    (hS : aeval x (∏ μ ∈ S, (X - C μ)) = 0) {f g : ℝ[X]}
    (h : ∀ μ ∈ S, f.eval μ = g.eval μ) : aeval x f = aeval x g := by
  by_cases hfg : f - g = 0
  · rw [sub_eq_zero.1 hfg]
  have hle : S.val ≤ (f - g).roots := by
    rw [Multiset.le_iff_subset S.nodup]
    intro μ hμ
    rw [mem_roots hfg]
    simp [IsRoot, h μ hμ]
  obtain ⟨r, hr⟩ := (Multiset.prod_X_sub_C_dvd_iff_le_roots hfg S.val).2 hle
  have : aeval x (f - g) = 0 := by
    rw [hr, map_mul]
    have : aeval x ((S.val.map fun a => X - C a).prod) = 0 := hS
    rw [this, zero_mul]
  rwa [map_sub, sub_eq_zero] at this

/-- The Lagrange basis polynomial at the node `μ` of the finite set `S`: it takes the value `1`
at `μ` and `0` at the other nodes. -/
noncomputable def basisPoly (S : Finset ℝ) (μ : ℝ) : ℝ[X] :=
  Lagrange.basis S id μ

/-- Values of `basisPoly` at the nodes. -/
theorem eval_basisPoly {S : Finset ℝ} {μ ν : ℝ} (hμ : μ ∈ S) (hν : ν ∈ S) :
    (basisPoly S μ).eval ν = if μ = ν then 1 else 0 := by
  unfold basisPoly
  split_ifs with h
  · subst h
    simpa using Lagrange.eval_basis_self (v := id) (Set.injOn_id _) hμ
  · simpa using Lagrange.eval_basis_of_ne (v := id) h hν

/-- The Lagrange idempotents of an element annihilated by `∏_{μ ∈ S} (X - μ)` are mutually
orthogonal. -/
theorem aeval_basisPoly_mul {x : M} {S : Finset ℝ}
    (hS : aeval x (∏ μ ∈ S, (X - C μ)) = 0) {μ ν : ℝ} (hμ : μ ∈ S) (hν : ν ∈ S) :
    aeval x (basisPoly S μ) * aeval x (basisPoly S ν) =
      if μ = ν then aeval x (basisPoly S μ) else 0 := by
  rw [← map_mul]
  by_cases h : μ = ν
  · rw [if_pos h]
    apply aeval_eq_of_eqOn_nodal hS
    intro κ hκ
    subst h
    rw [eval_mul, eval_basisPoly hμ hκ]
    split_ifs <;> simp
  · rw [if_neg h, ← map_zero (aeval (R := ℝ) x)]
    apply aeval_eq_of_eqOn_nodal hS
    intro κ hκ
    rw [eval_mul, eval_basisPoly hμ hκ, eval_basisPoly hν hκ]
    by_cases h1 : μ = κ
    · have : ν ≠ κ := fun h2 => h (h1.trans h2.symm)
      simp [this]
    · simp [h1]

/-- The Lagrange idempotents of an element annihilated by `∏_{μ ∈ S} (X - μ)` sum to `1`. -/
theorem aeval_basisPoly_sum {x : M} {S : Finset ℝ}
    (hS : aeval x (∏ μ ∈ S, (X - C μ)) = 0) :
    ∑ μ ∈ S, aeval x (basisPoly S μ) = 1 := by
  rw [← map_sum, ← map_one (aeval (R := ℝ) x)]
  apply aeval_eq_of_eqOn_nodal hS
  intro κ hκ
  rw [eval_finsetSum, eval_one, Finset.sum_congr rfl fun μ hμ => eval_basisPoly hμ hκ]
  simp [hκ]

/-- `x` acts on its Lagrange idempotent at `μ` as the scalar `μ`. -/
theorem mul_aeval_basisPoly {x : M} {S : Finset ℝ}
    (hS : aeval x (∏ μ ∈ S, (X - C μ)) = 0) {μ : ℝ} (hμ : μ ∈ S) :
    x * aeval x (basisPoly S μ) = μ • aeval x (basisPoly S μ) := by
  have h1 : x * aeval x (basisPoly S μ) = aeval x (X * basisPoly S μ) := by
    rw [map_mul, aeval_X]
  have h2 : μ • aeval x (basisPoly S μ) = aeval x (C μ * basisPoly S μ) := by
    rw [map_mul, aeval_C, Algebra.smul_def]
  rw [h1, h2]
  apply aeval_eq_of_eqOn_nodal hS
  intro κ hκ
  rw [eval_mul, eval_mul, eval_X, eval_C, eval_basisPoly hμ hκ]
  by_cases h : μ = κ
  · simp [h]
  · simp [h]

end Generic

/-- Orthogonality, idempotency and completeness for the products `∏_i E_i (l_i)` of commuting
families of orthogonal idempotents `E_i μ` (`μ ∈ S i`) summing to `1`, in a commutative ring. -/
theorem prod_basis_relations {R : Type*} [CommRing R] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (S : ι → Finset ℝ) (E : ι → ℝ → R)
    (hmul : ∀ i, ∀ μ ∈ S i, ∀ ν ∈ S i, E i μ * E i ν = if μ = ν then E i μ else 0)
    (hsum : ∀ i, ∑ μ ∈ S i, E i μ = 1) :
    (∀ l ∈ Fintype.piFinset S, ∀ m ∈ Fintype.piFinset S, l ≠ m →
        (∏ i, E i (l i)) * (∏ i, E i (m i)) = 0) ∧
    (∀ l ∈ Fintype.piFinset S, (∏ i, E i (l i)) * (∏ i, E i (l i)) = ∏ i, E i (l i)) ∧
    ∑ l ∈ Fintype.piFinset S, ∏ i, E i (l i) = 1 := by
  refine ⟨?_, ?_, ?_⟩
  · intro l hl m hm hlm
    obtain ⟨i, hi⟩ : ∃ i, l i ≠ m i := by
      by_contra h
      push Not at h
      exact hlm (funext h)
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_eq_zero (Finset.mem_univ i)
    rw [hmul i _ (Fintype.mem_piFinset.1 hl i) _ (Fintype.mem_piFinset.1 hm i), if_neg hi]
  · intro l hl
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [hmul i _ (Fintype.mem_piFinset.1 hl i) _ (Fintype.mem_piFinset.1 hl i), if_pos rfl]
  · rw [← Finset.prod_univ_sum]
    simp [hsum]


/-- An eigenvalue of `A` belongs to every finite set `S` whose nodal polynomial annihilates
`A`. -/
theorem mem_of_mulVec_eq {A : Matrix n n ℂ} {S : Finset ℝ}
    (hS : aeval A (∏ μ ∈ S, (X - C μ)) = 0) {v : n → ℂ} (hv : v ≠ 0) {ν : ℝ}
    (h : A.mulVec v = ν • v) : ν ∈ S := by
  have h1 := aeval_mulVec_of_mulVec_eq h (∏ μ ∈ S, (X - C μ))
  rw [hS, Matrix.zero_mulVec] at h1
  rcases smul_eq_zero.1 h1.symm with h2 | h2
  · rw [eval_prod] at h2
    obtain ⟨μ, hμ, h3⟩ := Finset.prod_eq_zero_iff.1 h2
    have : ν = μ := by simpa [sub_eq_zero] using h3
    exact this ▸ hμ
  · exact absurd h2 hv

open scoped IsMulCommutative in
/-- **Joint spectral projections of commuting Hermitian matrices**, for matrices indexed by an
arbitrary finite type `n`; see `exists_joint_spectral_projections` for the version on
`Fin d`.

There are a finite set `Λ` of real tuples and matrices `P l` (`l ∈ Λ`) such that

* each `P l` is Hermitian, idempotent and nonzero;
* `P l * P m = 0` for `l ≠ m`, and `∑_{l ∈ Λ} P l = 1`;
* `J i * P l = l i • P l`;
* every matrix commuting with all `J i` commutes with every `P l`;
* `l ∈ Λ` iff `l` is a joint eigenvalue tuple, i.e. the joint eigenspace of the `J i` for `l`
  is nonzero.

`P l` is the projection onto that joint eigenspace; it is constructed as `∏_i p_{i, l_i}(J_i)`
with `p_{i, μ}` the Lagrange basis polynomial of the spectrum of `J_i`. -/
theorem exists_joint_spectral_projections_fintype {ι : Type*} [Fintype ι] [DecidableEq ι]
    (J : ι → Matrix n n ℂ) (hJ : ∀ i, (J i).IsHermitian) (hc : ∀ i k, Commute (J i) (J k)) :
    ∃ (Λ : Finset (ι → ℝ)) (P : (ι → ℝ) → Matrix n n ℂ),
      (∀ l ∈ Λ, (P l).IsHermitian ∧ P l * P l = P l ∧ P l ≠ 0) ∧
      (∀ l ∈ Λ, ∀ m ∈ Λ, l ≠ m → P l * P m = 0) ∧ ∑ l ∈ Λ, P l = 1 ∧
      (∀ l ∈ Λ, ∀ i, J i * P l = ((l i : ℝ) : ℂ) • P l) ∧
      (∀ x : Matrix n n ℂ, (∀ i, Commute x (J i)) → ∀ l ∈ Λ, Commute x (P l)) ∧
      (∀ l : ι → ℝ, (∃ v : n → ℂ, v ≠ 0 ∧ ∀ i, (J i).mulVec v = ((l i : ℝ) : ℂ) • v) ↔
        l ∈ Λ) := by
  classical
  choose S hS using fun i => exists_nodal_annihilator (hJ i)
  let Z : Subalgebra ℝ (Matrix n n ℂ) := Algebra.adjoin ℝ (Set.range J)
  haveI : IsMulCommutative Z := Algebra.isMulCommutative_adjoin ℝ (by
    rintro _ ⟨i, rfl⟩ _ ⟨k, rfl⟩
    exact (hc i k).eq)
  let a : ι → Z := fun i => ⟨J i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  have haS : ∀ i, aeval (a i) (∏ μ ∈ S i, (X - C μ)) = 0 := by
    intro i
    apply Subtype.ext
    rw [Polynomial.aeval_subalgebra_coe]
    exact hS i
  let E : ι → ℝ → Z := fun i μ => aeval (a i) (basisPoly (S i) μ)
  have hEcoe : ∀ i μ, ((E i μ : Z) : Matrix n n ℂ) = aeval (J i) (basisPoly (S i) μ) := by
    intro i μ
    exact Polynomial.aeval_subalgebra_coe _ Z (a i)
  obtain ⟨hrel1, hrel2, hrel3⟩ := prod_basis_relations (R := Z) S E
    (fun i μ hμ ν hν => aeval_basisPoly_mul (haS i) hμ hν)
    (fun i => aeval_basisPoly_sum (haS i))
  obtain ⟨Pc, hPc⟩ : ∃ Pc : (ι → ℝ) → Z, ∀ l, Pc l = ∏ i, E i (l i) := ⟨_, fun _ => rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : (ι → ℝ) → Matrix n n ℂ, ∀ l, P l = (Pc l : Matrix n n ℂ) :=
    ⟨fun l => (Pc l : Matrix n n ℂ), fun _ => rfl⟩
  have hPH : ∀ l, (P l).IsHermitian := by
    intro l
    rw [hP, hPc]
    refine Finset.prod_induction (fun i => E i (l i))
      (fun c : Z => (c : Matrix n n ℂ).IsHermitian) ?_ ?_ ?_
    · intro c₁ c₂ h₁ h₂
      have hcomm : Commute (c₁ : Matrix n n ℂ) (c₂ : Matrix n n ℂ) := by
        show (c₁ : Matrix n n ℂ) * c₂ = c₂ * c₁
        rw [← Subalgebra.coe_mul, ← Subalgebra.coe_mul, mul_comm]
      rw [Subalgebra.coe_mul]
      exact (Matrix.IsHermitian.commute_iff h₁ h₂).1 hcomm
    · simp
    · intro i _
      rw [hEcoe]
      exact isHermitian_aeval (hJ i) _
  have hcentral : ∀ x : Matrix n n ℂ, (∀ i, Commute x (J i)) → ∀ c : Z,
      Commute x (c : Matrix n n ℂ) := by
    intro x hx c
    have hle : Z ≤ Subalgebra.centralizer ℝ ({x} : Set (Matrix n n ℂ)) := by
      apply Algebra.adjoin_le
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
      intro g hg
      rw [Set.mem_singleton_iff.1 hg]
      exact (hx i).eq
    exact (Subalgebra.mem_centralizer_iff ℝ).1 (hle c.2) x (Set.mem_singleton x)
  have hmemS : ∀ l ∈ Fintype.piFinset S, ∀ i, l i ∈ S i := fun l hl => Fintype.mem_piFinset.1 hl
  have hJP : ∀ l ∈ Fintype.piFinset S, ∀ i,
      J i * P l = ((l i : ℝ) : ℂ) • P l := by
    intro l hl i
    have h1 : a i * Pc l = (l i) • Pc l := by
      rw [hPc, ← Finset.mul_prod_erase Finset.univ (fun k => E k (l k)) (Finset.mem_univ i),
        ← mul_assoc]
      show a i * aeval (a i) (basisPoly (S i) (l i)) * _ = _
      rw [mul_aeval_basisPoly (haS i) (hmemS l hl i), smul_mul_assoc]
    have h2 := congrArg (fun c : Z => (c : Matrix n n ℂ)) h1
    simp only [Subalgebra.coe_mul, Subalgebra.coe_smul] at h2
    rw [hP, Complex.coe_smul]
    exact h2
  have hPeig : ∀ l ∈ Fintype.piFinset S, ∀ v : n → ℂ, v ≠ 0 →
      (∀ i, (J i).mulVec v = (l i) • v) → (P l).mulVec v = v := by
    intro l hl v hv0 hv
    rw [hP, hPc]
    refine Finset.prod_induction (fun i => E i (l i))
      (fun c : Z => (c : Matrix n n ℂ).mulVec v = v) ?_ ?_ ?_
    · intro c₁ c₂ h₁ h₂
      rw [Subalgebra.coe_mul, ← Matrix.mulVec_mulVec, h₂, h₁]
    · simp
    · intro i _
      rw [hEcoe, aeval_mulVec_of_mulVec_eq (hv i), eval_basisPoly (hmemS l hl i) (hmemS l hl i),
        if_pos rfl, one_smul]
  refine ⟨(Fintype.piFinset S).filter (fun l => P l ≠ 0), P, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro l hl
    obtain ⟨hl, hne⟩ := Finset.mem_filter.1 hl
    refine ⟨hPH l, ?_, hne⟩
    have h := hrel2 l hl
    rw [← hPc] at h
    rw [hP, ← Subalgebra.coe_mul, h]
  · intro l hl m hm hlm
    obtain ⟨hl, -⟩ := Finset.mem_filter.1 hl
    obtain ⟨hm, -⟩ := Finset.mem_filter.1 hm
    have h := hrel1 l hl m hm hlm
    rw [← hPc, ← hPc] at h
    rw [hP, hP, ← Subalgebra.coe_mul, h]
    rfl
  · rw [Finset.sum_filter_ne_zero]
    have h := hrel3
    simp only [← hPc] at h
    have h2 := congrArg (fun c : Z => (c : Matrix n n ℂ)) h
    have h3 : ((∑ l ∈ Fintype.piFinset S, Pc l : Z) : Matrix n n ℂ) =
        ∑ l ∈ Fintype.piFinset S, (Pc l : Matrix n n ℂ) := map_sum Z.val _ _
    simp only [hP]
    rw [← h3]
    simpa using h2
  · intro l hl i
    exact hJP l (Finset.mem_filter.1 hl).1 i
  · intro x hx l _
    rw [hP]
    exact hcentral x hx _
  · intro l
    constructor
    · rintro ⟨v, hv0, hv⟩
      have hv' : ∀ i, (J i).mulVec v = (l i) • v := by
        intro i
        rw [hv i, Complex.coe_smul]
      have hl : l ∈ Fintype.piFinset S :=
        Fintype.mem_piFinset.2 fun i => mem_of_mulVec_eq (hS i) hv0 (hv' i)
      refine Finset.mem_filter.2 ⟨hl, fun h0 => hv0 ?_⟩
      have := hPeig l hl v hv0 hv'
      rw [h0, Matrix.zero_mulVec] at this
      exact this.symm
    · intro hl
      obtain ⟨hl, hne⟩ := Finset.mem_filter.1 hl
      obtain ⟨w, hw⟩ : ∃ w : n → ℂ, (P l).mulVec w ≠ 0 := by
        by_contra hcon
        push Not at hcon
        exact hne (Matrix.ext_iff_mulVec.2 fun v => by simpa using hcon v)
      refine ⟨(P l).mulVec w, hw, fun i => ?_⟩
      rw [Matrix.mulVec_mulVec, hJP l hl i, Matrix.smul_mulVec]

end JointSpectralProjections

/-- **Joint spectral projections of commuting Hermitian matrices** (the linear-algebra content
of the phrase "a complete set of projectors onto the mutual eigenspaces of `{J_<C0>}`" in the
statement of v1 Theorem 2, `main.tex` L1258-1262, which the manuscript uses without proof).

Let `J i` (`i` in a finite type `ι`) be pairwise commuting Hermitian `d × d` complex matrices.
Then there are a finite set `Λ` of real tuples and matrices `P l` (`l ∈ Λ`) such that

* each `P l` is Hermitian, idempotent and nonzero;
* `P l * P m = 0` for `l ≠ m`, and `∑_{l ∈ Λ} P l = 1`;
* `J i * P l = l i • P l`;
* every matrix `x` commuting with all `J i` commutes with every `P l`;
* `l ∈ Λ` iff the joint eigenspace of the `J i` for `l` is nonzero.

The last conjunct is exactly the non-degeneracy bookkeeping needed to state the sector
hypotheses of the downstream Theorem 2 assembly for the sectors that occur.  The statement has
no premise beyond the manuscript setup (Hermitian, pairwise commuting). -/
theorem exists_joint_spectral_projections {d : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (J : ι → Matrix (Fin d) (Fin d) ℂ) (hJ : ∀ i, (J i).IsHermitian)
    (hc : ∀ i k, Commute (J i) (J k)) :
    ∃ (Λ : Finset (ι → ℝ)) (P : (ι → ℝ) → Matrix (Fin d) (Fin d) ℂ),
      (∀ l ∈ Λ, (P l).IsHermitian ∧ P l * P l = P l ∧ P l ≠ 0) ∧
      (∀ l ∈ Λ, ∀ m ∈ Λ, l ≠ m → P l * P m = 0) ∧ ∑ l ∈ Λ, P l = 1 ∧
      (∀ l ∈ Λ, ∀ i, J i * P l = ((l i : ℝ) : ℂ) • P l) ∧
      (∀ x, (∀ i, Commute x (J i)) → ∀ l ∈ Λ, Commute x (P l)) ∧
      (∀ l : ι → ℝ, (∃ v : Fin d → ℂ, v ≠ 0 ∧ ∀ i, (J i).mulVec v = ((l i : ℝ) : ℂ) • v) ↔
        l ∈ Λ) :=
  JointSpectralProjections.exists_joint_spectral_projections_fintype J hJ hc

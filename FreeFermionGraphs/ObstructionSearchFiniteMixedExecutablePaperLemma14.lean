import FreeFermionGraphs.ObstructionSearchFiniteMixedGeneratedDistinctPropagation

/-!
# Lemma 14 from executable finite obstruction-search data

This is the paper-facing endpoint of the finite Lemma 14 route.  Terminal-path
parity is derived from raw alternating coordinates.  Positive terminal degree
three is derived from the target-balance invariant preserved by `single` and
`snoc`.  Clone-to-flank adjacency is derived from the raw tether-link
coordinate.  The unequal-centre branch accepts only a bounded trace carrying an
`IsGenerated` derivation from the finite start and hop constructors.

Thus the theorem below has no terminal parity, degree, flank-adjacency, or
arbitrary propagation certificate among its assumptions.
-/

universe u

variable {V : Type u}

namespace SimpleGraph
namespace FixedPairingPathFamily

variable {G : SimpleGraph V}
  {families : PairingType → FixedPairingPathFamily G}
  {Cprime : Set V}

namespace ObstructionSearchInitialization

variable {I : ObstructionSearchInitialization families Cprime}

/-- Complete executable initialization data for the terminal part of Lemma 14.

The first field is generated by the literal terminal component and stopping
events together with the step-balance invariant of the finite execution.  The
second field requires an `IsGenerated` proof for every unequal-centre
propagation trace. -/
structure InitializationFiniteMixedSideExecutableLemma14Data
    (T : I.InitializationFiniteMixedSideTerminalCoreData) : Type (u + 1) where
  terminal : InitializationFiniteMixedSideBalancedExecutableTerminalEvent T
  propagation : ∀ hclaw : G.IsClawFree,
    let terminalData := terminal.toLabelledOperationalTerminalData hclaw
    let D := terminalData.toOperationalTerminalData.toTerminalTetherData
    FiniteMixedSideDistinctCenterGeneratedPropagationData T D hclaw

namespace InitializationFiniteMixedSideExecutableLemma14Data

variable {T : I.InitializationFiniteMixedSideTerminalCoreData}

/-- Exact manuscript Lemma 14 from executable finite search data and
claw-freeness. -/
theorem paperLemma14
    (L : InitializationFiniteMixedSideExecutableLemma14Data T)
    (hclaw : G.IsClawFree) :
    PaperLemma14Conclusion I := by
  let terminalData := L.terminal.toLabelledOperationalTerminalData hclaw
  let D := terminalData.toOperationalTerminalData.toTerminalTetherData
  have hgenerated :
      FiniteMixedSideDistinctCenterGeneratedPropagationData T D hclaw := by
    simpa [terminalData, D] using L.propagation hclaw
  exact D.paperLemma14_of_distinctCenterConsequences hclaw
    hgenerated.toTraceData.toDistinctCenterConsequences

end InitializationFiniteMixedSideExecutableLemma14Data

end ObstructionSearchInitialization
end FixedPairingPathFamily
end SimpleGraph
